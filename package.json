{
  "name": "peregrine",
  "version": "1.0.0-rc.3",
  "private": true,
  "description": "Peregrine: media discovery, library management, torrent acquisition, and playback.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @peregrine/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check-dead-deps": "node scripts/check-dead-deps.mjs",
    "clean:cache": "node scripts/clean-cache.mjs",
    "sidecars:fetch": "node scripts/fetch-sidecars.mjs",
    "gallery": "pnpm --filter @peregrine/desktop gallery",
    "tauri": "pnpm --filter @peregrine/desktop exec tauri"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "knip": "6.40.0",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
