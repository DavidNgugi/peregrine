<?xml version="1.0" encoding="UTF-8"?>
<widget
  xmlns="http://www.w3.org/ns/widgets"
  xmlns:tizen="http://tizen.org/ns/widgets"
  version="0.1.0"
  viewmodes="maximized"
>
  <!-- package must be ten characters on a Samsung TV; peregrine1.Peregrine is this app's
       identity and is never Clean Home's. Changing it means uninstalling first. -->
  <tizen:application id="peregrine1.Peregrine" package="peregrine1" required_version="6.0" />
  <feature name="http://tizen.org/feature/screen.size.all" />
  <access origin="*" subdomains="true" />
  <content src="index.html" />
  <icon src="icons/icon.png" />
  <name>Peregrine</name>
  <description>Open the Peregrine library on your television.</description>
  <tizen:profile name="tv" />
  <tizen:privilege name="http://tizen.org/privilege/internet" />
  <tizen:setting
    screen-orientation="landscape"
    context-menu="disable"
    background-support="disable"
    encryption="disable"
    install-location="auto"
    hwkey-event="enable"
  />
</widget>
