# Rust
/target/
**/target/
*.rs.bk

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo

# Frontend build output
apps/desktop/dist/
apps/web/dist/
packages/*/dist/
apps/desktop/src-tauri/gen/

# Tauri bundling
apps/desktop/src-tauri/target/

# Tooling caches
.vite/
coverage/
playwright-report/
test-results/
.eslintcache

# Local environment and secret files (never committed)
.env
.env.*
*.pem
*.p12

# Tizen packages are built locally and signed with one TV's certificate
apps/tizen/build/
*.wgt
apps/tizen/.manifest.tmp
apps/tizen/author-signature.xml
apps/tizen/signature*.xml

# Fetched sidecar binaries (scripts/fetch-sidecars.mjs)
/vendor/
apps/desktop/src-tauri/sidecars/*
!apps/desktop/src-tauri/sidecars/.gitkeep

# Local runtime state (never committed)
*.sqlite
*.sqlite-wal
*.sqlite-shm
.peregrine/

# OS noise
.DS_Store
Thumbs.db
